# Скопируйте на сервер: ~/familygraph/public_html/.env

DJANGO_SECRET_KEY=сгенерируйте-длинный-случайный-ключ
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=genbu.ru,www.genbu.ru
CSRF_TRUSTED_ORIGINS=https://genbu.ru,https://www.genbu.ru
DJANGO_COOKIE_SECURE=True

# MySQL из панели Timeweb (Без DB_NAME останется SQLite)
DB_NAME=ck78395_family
DB_USER=ck78395_family
DB_PASSWORD=пароль_из_панели
DB_HOST=localhost
DB_PORT=3306
